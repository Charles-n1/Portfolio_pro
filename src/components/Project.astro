---
const {title, desc, img, link, class: classname} = Astro.props
---

<project class={classname}>
    <span class="title"> {title} </span>
    <img class="imgg" src={img}/>
    <div class="detail">
        <span class="dtitle">{title}</span>
        <img class="dimg" src={img}/>
        <span class="ddesc">{desc}</span>
        <a class="dlink" href={link}>More detail</a>
    </div>
</project>

<style>
    project {
        display: grid;
        grid-template: 20% 80% / 100%;

        background-color: rgba(96, 100, 112, 0.55);
        backdrop-filter: blur(6px);
        border: 3px solid rgba(147, 222, 255, 0.5);
        border-radius: 10px;
        color: var(--color-text, #F7F7F7);
        position: relative;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    }
    .detail {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 180%;
        height: 180%;
        background-color: rgba(50, 54, 67, 0.95);
        border: 3px solid var(--color-accent, #93DEFF);
        border-radius: 10px;
        color: var(--color-text, #F7F7F7);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        z-index: 2;

        grid-template-rows: auto 100px auto;
        justify-items: center;
        align-content: start;
    }
    project:not(:hover) {
        .detail {
            display: none;
        }
    }
    project:hover {
        .detail {
            display: grid;
        }
    }
    .title {
        justify-self: center;
        font-size: 25px;
    }
    .imgg {
        justify-self: center;
        height: 200px;
        width: 200px;
    }
    .dtitle {
        font-size: 25px;
    }
    .dimg {
        height: 100px;
        width: 100px;
    }
    .ddesc {
        font-size: 20px;
    }
    .dlink {
        position: absolute;
        bottom: 10px;
        left: 10px;
        font-size: 20px;
        color: var(--color-accent, #93DEFF);
    }
    .dlink:hover {
        color: var(--color-text, #F7F7F7);
    }
</style>