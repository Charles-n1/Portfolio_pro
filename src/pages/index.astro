---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { profile, internships, projects, hobbies, contacts } from '../data/portfolio';
---

<Layout title={profile.shortTitle}>
    <Header />

    <main>
        <!-- HERO (Brutaliste noir & blanc avec accent bleu) -->
        <section id="home" class="hero">
            <div class="container hero-inner">
                <h1 class="hero-title">
                    <span class="hero-line-primary">{profile.heroLine1}</span>
                    <span class="hero-line-secondary">{profile.heroLine2}</span>
                </h1>

                <p class="hero-bio">{profile.heroBio}</p>

                <a href="#work" class="hero-cta">
                    <span>{profile.ctaLabel}</span>
                    <span class="arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </section>

        <!-- 01 — STAGES -->
        <section id="stages" class="section">
            <div class="container">
                <div class="section-head">
                    <span class="section-index">01 / STAGES</span>
                    <h2 class="section-title">Expériences en laboratoire.</h2>
                </div>

                <div class="stages-grid">
                    {internships.map((stage, idx) => (
                        <button
                            type="button"
                            class="project-card"
                            data-stage-index={idx}
                            aria-haspopup="dialog"
                        >
                            <div class="project-top">
                                <span class="project-num">{stage.index}</span>
                                <span class="project-meta">{stage.theme}</span>
                            </div>

                            <h3 class="project-title">{stage.organization}</h3>
                            <p class="project-desc">{stage.role} — {stage.summary}</p>

                            <div class="project-footer">
                                <ul class="stack-list">
                                    {stage.stack.map((tech) => (
                                        <li>{tech}</li>
                                    ))}
                                </ul>

                                <span class="project-link" aria-hidden="true">DÉTAILS +</span>
                            </div>
                        </button>
                    ))}
                </div>
            </div>
        </section>

        <!-- 02 — PROJETS -->
        <section id="work" class="section">
            <div class="container">
                <div class="section-head">
                    <span class="section-index">02 / PROJETS</span>
                    <h2 class="section-title">Travaux sélectionnés.</h2>
                </div>

                <div class="projects-grid">
                    {projects.map((project, idx) => (
                        <button
                            type="button"
                            class:list={['project-card', { 'is-extra': project.extra }]}
                            data-project-index={idx}
                            aria-haspopup="dialog"
                        >
                            <div class="project-top">
                                <span class="project-num">{project.index}</span>
                                <span class="project-meta">{project.category}</span>
                            </div>

                            <h3 class="project-title">{project.title}</h3>
                            <p class="project-desc">{project.description}</p>

                            <div class="project-footer">
                                <ul class="stack-list">
                                    {project.stack.map((tech) => (
                                        <li>{tech}</li>
                                    ))}
                                </ul>

                                <span class="project-link" aria-hidden="true">DÉTAILS +</span>
                            </div>
                        </button>
                    ))}
                </div>

                <div class="projects-toggle-wrap">
                    <button type="button" id="toggle-projects" class="brutal-btn" aria-expanded="false">
                        VOIR PLUS DE PROJETS +
                    </button>
                </div>
            </div>
        </section>

        <!-- MODALE DÉTAIL PROJET -->
        <dialog id="project-modal" class="project-modal" aria-labelledby="modal-title">
            <div class="modal-box">
                <div class="modal-top">
                    <span id="modal-meta" class="modal-meta"></span>
                    <button type="button" id="modal-close" class="modal-close" aria-label="Fermer">
                        FERMER ✕
                    </button>
                </div>

                <span id="modal-theme" class="modal-theme"></span>
                <h3 id="modal-title" class="modal-title"></h3>
                <p id="modal-summary" class="modal-summary"></p>

                <div class="modal-section">
                    <span class="modal-label">POINTS TRAVAILLÉS</span>
                    <ul id="modal-highlights" class="modal-highlights"></ul>
                </div>

                <div class="modal-bottom">
                    <ul id="modal-stack" class="stack-list"></ul>
                    <a
                        id="modal-link"
                        href="https://github.com/Charles-n1"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="modal-github"
                    >
                        GITHUB ↗
                    </a>
                </div>
            </div>
        </dialog>

        <!-- 03 — À PROPOS -->
        <section id="about" class="section">
            <div class="container">
                <div class="section-head">
                    <span class="section-index">03 / À PROPOS</span>
                    <h2 class="section-title">Profil & Spécialités.</h2>
                </div>

                <div class="about-grid">
                    <div class="about-text">
                        <p class="about-lead">{profile.aboutLead}</p>
                        <p class="about-body">{profile.aboutBody}</p>

                        <div class="focus-list">
                            {profile.focusAreas.map((area) => (
                                <div class="focus-row">
                                    <span class="focus-num">{area.index}</span>
                                    <div>
                                        <h3 class="focus-title">{area.title}</h3>
                                        <p class="focus-desc">{area.description}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <figure class="portrait-frame">
                        <img src={profile.avatar} alt="Portrait de Charles Nguyen" class="portrait-img" />
                        <figcaption class="portrait-caption">
                            <span>CHARLES NGUYEN</span>
                            <span>EPITECH — 3E ANNÉE</span>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <!-- 04 — LOISIRS -->
        <section id="hobbies" class="section">
            <div class="container">
                <div class="section-head">
                    <span class="section-index">04 / LOISIRS</span>
                    <h2 class="section-title">En dehors du code.</h2>
                </div>

                <div class="hobbies-list">
                    {hobbies.map((hobby) => (
                        <div class="hobby-row">
                            <span class="hobby-num">{hobby.index}</span>
                            <h3 class="hobby-title">{hobby.title}</h3>
                            <p class="hobby-detail">{hobby.detail}</p>
                            <div class="hobby-icon-wrap">
                                <img src={hobby.icon} alt={hobby.title} class="hobby-icon" />
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 05 — CONTACT -->
        <section id="contact" class="section section-contact">
            <div class="container">
                <div class="section-head">
                    <span class="section-index">05 / CONTACT</span>
                    <h2 class="section-title">Travaillons ensemble.</h2>
                </div>

                <p class="contact-intro">
                    Disponible pour des échanges, stages, projets Web ou Intelligence Artificielle.
                </p>

                <div class="contact-grid">
                    {contacts.map((item) => (
                        <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="contact-card"
                        >
                            <span class="contact-label">{item.label}</span>
                            <span class="contact-value">{item.value}</span>
                            <span class="contact-arrow" aria-hidden="true">↗</span>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>© {new Date().getFullYear()} {profile.name}</span>
            <span>EPITECH — WEB & IA</span>
        </div>
    </footer>

    <script is:inline define:vars={{ projectsData: projects, stagesData: internships }}>
        const modal = document.getElementById('project-modal');
        const modalMeta = document.getElementById('modal-meta');
        const modalTheme = document.getElementById('modal-theme');
        const modalTitle = document.getElementById('modal-title');
        const modalSummary = document.getElementById('modal-summary');
        const modalHighlights = document.getElementById('modal-highlights');
        const modalStack = document.getElementById('modal-stack');
        const modalLink = document.getElementById('modal-link');
        const modalClose = document.getElementById('modal-close');

        const openDetailModal = ({ meta, theme, title, summary, highlights, stack, link }) => {
            if (!modal) return;
            modalMeta.textContent = meta;
            modalTheme.textContent = theme;
            modalTitle.textContent = title;
            modalSummary.textContent = summary;

            modalHighlights.innerHTML = '';
            highlights.forEach((point) => {
                const li = document.createElement('li');
                li.textContent = point;
                modalHighlights.appendChild(li);
            });

            modalStack.innerHTML = '';
            stack.forEach((tech) => {
                const li = document.createElement('li');
                li.textContent = tech;
                modalStack.appendChild(li);
            });

            if (link) {
                modalLink.href = link;
                modalLink.hidden = false;
            } else {
                modalLink.hidden = true;
            }

            modal.showModal();
        };

        document.querySelectorAll('[data-stage-index]').forEach((card) => {
            card.addEventListener('click', () => {
                const idx = Number(card.getAttribute('data-stage-index'));
                const stage = stagesData[idx];
                if (!stage) return;
                openDetailModal({
                    meta: `${stage.index} · STAGE · ${stage.period}`,
                    theme: stage.theme,
                    title: stage.organization,
                    summary: `${stage.role} — ${stage.summary}`,
                    highlights: stage.highlights,
                    stack: stage.stack,
                    link: null,
                });
            });
        });

        document.querySelectorAll('[data-project-index]').forEach((card) => {
            card.addEventListener('click', () => {
                const idx = Number(card.getAttribute('data-project-index'));
                const project = projectsData[idx];
                if (!project) return;
                openDetailModal({
                    meta: `${project.index} · ${project.context} · ${project.year}`,
                    theme: project.category,
                    title: project.title,
                    summary: project.description,
                    highlights: project.highlights,
                    stack: project.stack,
                    link: project.link,
                });
            });
        });

        modalClose?.addEventListener('click', () => modal?.close());

        modal?.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.close();
            }
        });

        const toggleBtn = document.getElementById('toggle-projects');
        const extraCards = document.querySelectorAll('.project-card.is-extra');

        if (toggleBtn && extraCards.length > 0) {
            let expanded = false;
            toggleBtn.addEventListener('click', () => {
                expanded = !expanded;
                extraCards.forEach((card) => card.classList.toggle('is-visible', expanded));
                toggleBtn.setAttribute('aria-expanded', String(expanded));
                toggleBtn.textContent = expanded ? 'VOIR MOINS DE PROJETS −' : 'VOIR PLUS DE PROJETS +';
            });
        }
    </script>
</Layout>

<style>
    .container {
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 32px;
    }

    /* HERO */
    .hero {
        min-height: calc(100vh - 68px);
        display: flex;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding: 80px 0 100px;
    }

    .hero-inner {
        width: 100%;
    }

    .hero-title {
        margin: 0 0 32px;
        font-family: var(--font-display);
        font-size: clamp(3rem, 8.2vw, 6.4rem);
        line-height: 0.98;
        letter-spacing: -0.03em;
    }

    .hero-line-primary {
        display: block;
        color: var(--fg);
    }

    .hero-line-secondary {
        display: block;
        color: var(--accent);
    }

    .hero-bio {
        margin: 0 0 44px;
        max-width: 560px;
        font-size: clamp(1rem, 1.5vw, 1.2rem);
        line-height: 1.65;
        color: var(--fg-muted);
    }

    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: var(--fg);
        padding-bottom: 6px;
        border-bottom: 2px solid var(--fg);
        transition: opacity 0.15s ease;
    }

    .hero-cta .arrow {
        display: inline-block;
        transition: transform 0.2s ease;
    }

    .hero-cta:hover .arrow {
        transform: translateX(6px);
    }

    /* SECTIONS */
    .section {
        padding: 110px 0;
        border-bottom: 1px solid var(--border);
    }

    .section-head {
        margin-bottom: 56px;
    }

    .section-index {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: var(--fg-muted);
        margin-bottom: 14px;
    }

    .section-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
    }

    /* STAGES */
    .stages-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--border);
        border-left: 1px solid var(--border);
    }

    .stage-card {
        display: flex;
        flex-direction: column;
        padding: 36px;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background-color: var(--bg);
    }

    .stage-role {
        margin: 0 0 18px;
        font-size: 0.96rem;
        line-height: 1.55;
        color: var(--fg-muted);
    }

    .stage-highlights {
        margin: 0 0 28px;
        padding-left: 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-size: 0.92rem;
        line-height: 1.55;
        color: var(--fg-muted);
        flex-grow: 1;
    }

    /* PROJETS */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--border);
        border-left: 1px solid var(--border);
    }

    .project-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        text-align: left;
        font-family: inherit;
        color: var(--fg);
        padding: 36px;
        border: none;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background-color: var(--bg);
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .project-card:hover {
        background-color: var(--fg);
        color: var(--bg);
    }

    .project-card.is-extra {
        display: none;
    }

    .project-card.is-extra.is-visible {
        display: flex;
    }

    .project-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        width: 100%;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        color: var(--fg-muted);
        margin-bottom: 28px;
    }

    .project-card:hover .project-top,
    .project-card:hover .project-desc {
        color: #2b2b2b;
    }

    .project-num {
        font-weight: 700;
        color: var(--fg);
    }

    .project-card:hover .project-num {
        color: var(--bg);
    }

    .project-title {
        margin: 0 0 14px;
        font-family: var(--font-display);
        font-size: 1.75rem;
        letter-spacing: -0.02em;
    }

    .project-desc {
        margin: 0 0 32px;
        font-size: 0.98rem;
        line-height: 1.65;
        color: var(--fg-muted);
        flex-grow: 1;
    }

    .project-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        width: 100%;
        padding-top: 20px;
        border-top: 1px solid var(--border);
    }

    /* MODALE PROJET */
    .project-modal {
        padding: 0;
        border: 1px solid var(--fg);
        background-color: var(--bg);
        color: var(--fg);
        width: min(680px, calc(100vw - 32px));
        max-height: calc(100vh - 48px);
        overflow-y: auto;
    }

    .project-modal::backdrop {
        background-color: rgba(0, 0, 0, 0.82);
        backdrop-filter: blur(4px);
    }

    .modal-box {
        padding: 36px;
    }

    .modal-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding-bottom: 20px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--border);
    }

    .modal-meta {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.12em;
        color: var(--fg-muted);
    }

    .modal-close {
        background: transparent;
        color: var(--fg);
        border: 1px solid var(--border-strong);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        padding: 8px 12px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .modal-close:hover {
        background-color: var(--fg);
        color: var(--bg);
    }

    .modal-theme {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: var(--accent);
        margin-bottom: 10px;
    }

    .modal-title {
        margin: 0 0 12px;
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 3.5vw, 2.3rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
    }

    .modal-summary {
        margin: 0 0 28px;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--fg-muted);
    }

    .modal-section {
        padding: 24px 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 24px;
    }

    .modal-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: var(--fg-muted);
        margin-bottom: 14px;
    }

    .modal-highlights {
        margin: 0;
        padding-left: 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 0.96rem;
        line-height: 1.6;
        color: var(--fg);
    }

    .modal-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .modal-github {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        padding: 10px 16px;
        border: 1px solid var(--fg);
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .modal-github:hover {
        background-color: var(--fg);
        color: var(--bg);
    }

    .project-card:hover .project-footer {
        border-top-color: #d4d4d4;
    }

    .stack-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
    }

    .stack-list li {
        border: 1px solid var(--border-strong);
        padding: 4px 8px;
    }

    .project-card:hover .stack-list li {
        border-color: #080808;
    }

    .project-link {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        white-space: nowrap;
    }

    .projects-toggle-wrap {
        margin-top: 32px;
    }

    .brutal-btn {
        background: transparent;
        color: var(--fg);
        border: 1px solid var(--fg);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        padding: 14px 24px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .brutal-btn:hover {
        background-color: var(--fg);
        color: var(--bg);
    }

    /* À PROPOS */
    .about-grid {
        display: grid;
        grid-template-columns: 1.35fr 0.85fr;
        gap: 64px;
        align-items: start;
    }

    .about-lead {
        margin: 0 0 20px;
        font-size: 1.45rem;
        font-weight: 600;
        line-height: 1.45;
        color: var(--fg);
    }

    .about-body {
        margin: 0 0 44px;
        font-size: 1rem;
        line-height: 1.75;
        color: var(--fg-muted);
    }

    .focus-list {
        border-top: 1px solid var(--border);
    }

    .focus-row {
        display: grid;
        grid-template-columns: 48px 1fr;
        gap: 16px;
        padding: 22px 0;
        border-bottom: 1px solid var(--border);
    }

    .focus-num {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--fg-muted);
        padding-top: 3px;
    }

    .focus-title {
        margin: 0 0 6px;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .focus-desc {
        margin: 0;
        font-size: 0.94rem;
        line-height: 1.6;
        color: var(--fg-muted);
    }

    .portrait-frame {
        margin: 0;
        border: 1px solid var(--border-strong);
        background-color: var(--bg-elevated);
    }

    .portrait-img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        filter: grayscale(100%) contrast(1.12);
        transition: filter 0.3s ease;
    }

    .portrait-frame:hover .portrait-img {
        filter: grayscale(100%) contrast(1.22);
    }

    .portrait-caption {
        display: flex;
        justify-content: space-between;
        padding: 12px 16px;
        border-top: 1px solid var(--border-strong);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        color: var(--fg-muted);
    }

    /* LOISIRS */
    .hobbies-list {
        border-top: 1px solid var(--border);
    }

    .hobby-row {
        display: grid;
        grid-template-columns: 64px 1.1fr 1.6fr 72px;
        gap: 24px;
        align-items: center;
        padding: 28px 16px;
        border-bottom: 1px solid var(--border);
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .hobby-row:hover {
        background-color: var(--fg);
        color: var(--bg);
    }

    .hobby-num {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--fg-muted);
    }

    .hobby-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.45rem;
        letter-spacing: -0.01em;
    }

    .hobby-detail {
        margin: 0;
        font-size: 0.96rem;
        line-height: 1.6;
        color: var(--fg-muted);
    }

    .hobby-row:hover .hobby-num,
    .hobby-row:hover .hobby-detail {
        color: #2b2b2b;
    }

    .hobby-icon-wrap {
        display: flex;
