---
import Header from './Header.astro';
import BackgroundDepth from './BackgroundDepth.astro';
import Presentation from '../pages/Presentation.astro';
import Projets from '../pages/Projects.astro';
import Loisirs from '../pages/Loisirs.astro';
import Contacts from '../pages/Contacts.astro';

interface Props {
    mode: 'animated' | 'static';
}

const { mode } = Astro.props;
const staticMode = mode === 'static';
---

<div class={`portfolio-stage mode-${mode}`}>
    <BackgroundDepth />
    <Header />
    <Presentation staticMode={staticMode} />
    <Projets staticMode={staticMode} />
    <Loisirs staticMode={staticMode} />
    <Contacts staticMode={staticMode} />
</div>

<style>
    .portfolio-stage {
        position: relative;
        min-height: 100vh;
        background: transparent;
        isolation: isolate;
    }

    .mode-static :global(*),
    .mode-static :global(*::before),
    .mode-static :global(*::after) {
        animation: none !important;
    }
</style>
