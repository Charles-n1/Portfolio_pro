<div class="bg-depth" aria-hidden="true">
    <!-- Couche lointaine (profondeur 3) -->
    <div class="depth-layer layer-far">
        <span class="depth-shape glow-1"></span>
        <span class="depth-shape glow-2"></span>
        <span class="depth-shape glow-3"></span>
        <span class="depth-shape bar-far-1"></span>
        <span class="depth-shape bar-far-2"></span>
        <span class="depth-shape bar-far-3"></span>
        <span class="depth-shape bar-far-4"></span>
    </div>

    <!-- Couche intermédiaire (profondeur 2) -->
    <div class="depth-layer layer-mid">
        <span class="depth-shape panel-mid-1"></span>
        <span class="depth-shape panel-mid-2"></span>
        <span class="depth-shape panel-mid-3"></span>
        <span class="depth-shape panel-mid-4"></span>
        <span class="depth-shape panel-mid-5"></span>
    </div>

    <!-- Couche proche (profondeur 1) -->
    <div class="depth-layer layer-near">
        <span class="depth-shape accent-near-1"></span>
        <span class="depth-shape accent-near-2"></span>
        <span class="depth-shape accent-near-3"></span>
        <span class="depth-shape accent-near-4"></span>
        <span class="depth-shape accent-near-5"></span>
    </div>
</div>

<style>
    .bg-depth {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
        z-index: -2;
        background: transparent;
    }

    .depth-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .depth-shape {
        position: absolute;
        display: block;
        border-radius: 6px;
        opacity: var(--target-opacity, 1);
        animation: slideFromBottomLeft 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* Couche lointaine : grands halos et formes floutées pour la profondeur */
    .layer-far {
        z-index: -4;
    }

    .glow-1 {
        top: 6%;
        left: 10%;
        width: 480px;
        height: 480px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(147, 222, 255, 0.22), transparent 70%);
        filter: blur(28px);
        --target-opacity: 0.7;
        animation-delay: 0.05s;
    }

    .glow-2 {
        top: 42%;
        right: 8%;
        width: 560px;
        height: 560px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(96, 100, 112, 0.45), transparent 70%);
        filter: blur(32px);
        --target-opacity: 0.8;
        animation-delay: 0.12s;
    }

    .glow-3 {
        top: 76%;
        left: 15%;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(147, 222, 255, 0.18), transparent 70%);
        filter: blur(30px);
        --target-opacity: 0.75;
        animation-delay: 0.18s;
    }

    .bar-far-1 {
        top: 12%;
        left: -8%;
        width: 55vw;
        height: 160px;
        rotate: -35deg;
        background: rgba(96, 100, 112, 0.22);
        filter: blur(3px);
        --target-opacity: 0.65;
        animation-delay: 0.08s;
    }

    .bar-far-2 {
        top: 34%;
        right: -12%;
        width: 60vw;
        height: 200px;
        rotate: -35deg;
        background: rgba(96, 100, 112, 0.18);
        filter: blur(4px);
        --target-opacity: 0.6;
        animation-delay: 0.16s;
    }

    .bar-far-3 {
        top: 62%;
        left: -10%;
        width: 62vw;
        height: 180px;
        rotate: -44deg;
        background: rgba(96, 100, 112, 0.2);
        filter: blur(3px);
        --target-opacity: 0.65;
        animation-delay: 0.22s;
    }

    .bar-far-4 {
        top: 84%;
        right: -8%;
        width: 50vw;
        height: 150px;
        rotate: -35deg;
        background: rgba(147, 222, 255, 0.1);
        filter: blur(3px);
        --target-opacity: 0.65;
        animation-delay: 0.26s;
    }

    /* Couche intermédiaire : panneaux translucides (#606470 + bordure #93DEFF) */
    .layer-mid {
        z-index: -3;
    }

    .panel-mid-1 {
        top: 8%;
        right: 12%;
        width: 340px;
        height: 90px;
        rotate: -35deg;
        background: rgba(96, 100, 112, 0.28);
        border: 1px solid rgba(147, 222, 255, 0.28);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        --target-opacity: 0.85;
        animation-delay: 0.14s;
    }

    .panel-mid-2 {
        top: 28%;
        left: 6%;
        width: 420px;
        height: 110px;
        rotate: -35deg;
        background: rgba(96, 100, 112, 0.25);
        border: 1px solid rgba(247, 247, 247, 0.18);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        --target-opacity: 0.8;
        animation-delay: 0.2s;
    }

    .panel-mid-3 {
        top: 50%;
        right: 10%;
        width: 380px;
        height: 100px;
        rotate: -35deg;
        background: rgba(147, 222, 255, 0.12);
        border: 1px solid rgba(147, 222, 255, 0.35);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
        --target-opacity: 0.85;
        animation-delay: 0.28s;
    }

    .panel-mid-4 {
        top: 70%;
        left: 8%;
        width: 360px;
        height: 95px;
        rotate: -44deg;
        background: rgba(96, 100, 112, 0.28);
        border: 1px solid rgba(147, 222, 255, 0.25);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
        --target-opacity: 0.8;
        animation-delay: 0.34s;
    }

    .panel-mid-5 {
        top: 88%;
        left: 38%;
        width: 400px;
        height: 85px;
        rotate: -35deg;
        background: rgba(96, 100, 112, 0.24);
        border: 1px solid rgba(247, 247, 247, 0.18);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
        --target-opacity: 0.8;
        animation-delay: 0.4s;
    }

    /* Couche proche : fines lignes lumineuses (#93DEFF / #F7F7F7) */
    .layer-near {
        z-index: -2;
    }

    .accent-near-1 {
        top: 15%;
