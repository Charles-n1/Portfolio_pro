---
import Project from "../components/Project.astro"
import Deco from "../components/Deco.astro"
const { staticMode = true } = Astro.props;
---

<projects id={staticMode ? "idproj" : undefined}>
    <Deco src="/decorations/rect_5.svg" bottom="-378px" left="-160px" width="375px" height="112px" rotate="-34.5deg"/>
    <Deco src="/decorations/rect_w5.svg" top="1404px" left="1163px" width="1012.5px" height="40.5px" rotate="-35deg"/>
    <Deco src="/decorations/rect_12.svg" top="1490px" left="917.5px" width="570px" height="300px" rotate="-35deg"/>
    <Deco src="/decorations/rect_11.svg" top="1640px" left="930.5px" width="570px" height="300px" rotate="-35deg"/>
    <Deco src="/decorations/eclair_7.svg" top="calc(var(--list-len-opened) + 1582px + 50vh)" left="-15%" width="130%" rotate="2deg"/>
    <Deco src="/decorations/rect_24_eclair7.svg" top="calc(var(--list-len-opened) + 2280px)" left="-130.5px" width="570px" height="300px" rotate="-33deg"/>
    <div class="section-center">
        <span class="mtitle"> Mes projets </span>
        <span class="list">
            <Project title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://diep.io" />
            <Project title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://agar.io" />
            <Project title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://slither.io" />

            <Project title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://moomoo.io" />
            <Project title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://diep.io" />
            <Project title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://agar.io" />

            <Project class="extra" title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://diep.io" />
            <Project class="extra" title="zappy" desc="zap zapet zappy !!" img="/decorations/gear.svg" link="https://diep.io" />
            <Project class="extra" title="zappy" desc="zap zap zappy !!" img="/decorations/gear.svg" link="https://diep.io" />
        </span>
        <details>
            <summary>
                See more projects
            </summary>
        </details>
    </div>
</projects>

<style>
    projects {
        display: grid;
        justify-content: center;
        padding-bottom: 370px;
        background: transparent;
    }
    .section-center {
        display: grid;
        grid-template: auto auto auto / auto;
        justify-content: center;
        justify-items: center;
        gap: 40px;
    }
    body:has(#idproj details[open]) {
        .extra {
            display: grid;
        }
    }
    body:has(#idproj details:not([open])) {
        .extra {
            display: none;
        }
    }
    .list {
        display: grid;
        grid-template-columns: repeat(3, 300px);   /* seulement les colonnes */
        grid-auto-rows: 300px;
        justify-content: center;
        align-content: center;
        gap: 80px;

        min-height: 70vh;
    }
    button {
        border: none;
        background: none;
        font-size: 25px;
        color: var(--color-text, #F7F7F7);
    }
    button:hover {
        color: var(--color-accent, #93DEFF);
    }
    details {
        justify-self: center;
        font-size: 40px;
        color: var(--color-text, #F7F7F7);
        cursor: pointer;
    }
    details:hover {
        color: var(--color-accent, #93DEFF);
    }
    .mtitle {
        font-size: 55px;
        text-align: center;
        color: var(--color-text, #F7F7F7);
    }
    .mtitle:hover {
        color: var(--color-accent, #93DEFF);
    }
</style>
