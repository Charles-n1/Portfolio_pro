---
import Rs from "../components/Rs.astro"
import Deco from "../components/Deco.astro";
const { staticMode = true } = Astro.props;
---

<contacts id={staticMode ? "idcont" : undefined}>
    <Deco src="/decorations/eclair_8.svg" top="calc(var(--list-len-opened) + 3540px)" left="-100px" width="130%" rotate="2deg"/>
    <Deco src="/decorations/rect_5.svg" top="calc(var(--list-len-opened) + 4220px)" left="1450px" width="550px" height="165px" rotate="-44deg"/>
    <div class="content">
        <div class="list">
            <Rs src="/logos/linkedin.png" link="https://www.linkedin.com/in/charles-pro-nguyen/"/>
            <Rs src="/logos/github.png" link="https://github.com/Charles-n1"/>
            <Rs src="/logos/gmail.png" link="https://mail.google.com/mail/?view=cm&fs=1&to=charles.pro.nguyen@gmail.com"/>
            <Rs src="/logos/outlook.png" link="https://outlook.office.com/mail/deeplink/compose?to=charles.nguyen@epitech.eu"/>
        </div>
    </div>
</contacts>

<style>
    contacts {
        display: block;
        background: transparent;
        padding-bottom: 20px;
    }
    .content {
        display: grid;
        grid-template: 1fr / 1fr;
        align-content: center;
        justify-items: center;
        align-items: center;

        min-height: 28vh;
        max-width: 100vw;
        overflow-y: clip;
    }
    .list {
        display: grid;
        grid-template: 1fr 1fr / 1fr 1fr;
        min-width: 18vw;
        gap: 20px;
        padding: 20px;
        border-radius: 16px;
        background: rgba(96, 100, 112, 0.35);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(147, 222, 255, 0.3);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);

        justify-items: center;
        align-items: center;
    }
</style>
