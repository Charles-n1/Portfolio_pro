---
const {src, link} = Astro.props;
---

<rs>
    <a href={link} target="_blank">
        <img src={src}/>
    </a>
</rs>

<style>
    rs {
        display: inline-flex;
    }
    .rs:active {
        color: var(--color-accent, #93DEFF);
    }
    img {
        height: 80px;
        width: 80px;
        transition: transform 0.2s ease, filter 0.2s ease;
    }
    img:hover {
        transform: scale(1.08);
        filter: drop-shadow(0 0 12px rgba(147, 222, 255, 0.65));
    }
</style>