        rotate: -35deg;
        background: linear-gradient(90deg, transparent, rgba(247, 247, 247, 0.6), transparent);
        --target-opacity: 0.85;
        animation-delay: 0.3s;
    }

    .accent-near-3 {
        top: 56%;
        left: 16%;
        width: 260px;
        height: 4px;
        rotate: -35deg;
        background: linear-gradient(90deg, transparent, rgba(147, 222, 255, 0.7), transparent);
        --target-opacity: 0.85;
